# Example environment configuration template (safe to commit to git)

# Server Configuration
SERVER_PORT=8080
HOST_IP=127.0.0.1
GIN_MODE=debug

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=chat_app_db
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/chat_app_db?sslmode=disable

# Storage Paths & File Uploads
UPLOAD_DIR=./uploads
STATIC_DIR=./static
STICKERS_DIR=./static/stickers
MAX_FILE_SIZE_BYTES=20971520

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_key_in_production
JWT_EXPIRATION=72h
